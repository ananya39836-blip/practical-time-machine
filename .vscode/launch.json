{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Debug: PTM Engine (--all)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cpp/bin/ptm_engine.exe",
            "args": ["--all"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/cpp",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
            "preLaunchTask": "C++: Build PTM Engine & Unit Tests",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "C++ Debug: OOP Polymorphism Demo (--oop)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cpp/bin/ptm_engine.exe",
            "args": ["--oop"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/cpp",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
            "preLaunchTask": "C++: Build PTM Engine & Unit Tests"
        },
        {
            "name": "C++ Debug: PTM Unit Test Suite",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cpp/bin/ptm_tests.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/cpp",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
            "preLaunchTask": "C++: Build PTM Engine & Unit Tests"
        }
    ]
}
